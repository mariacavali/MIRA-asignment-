# Core application and database
DATABASE_URL=
JWT_SECRET=
VITE_APP_ID=
OAUTH_SERVER_URL=
VITE_OAUTH_PORTAL_URL=
OWNER_OPEN_ID=

# Optional isolated local/test authentication
DEV_LOCAL_AUTH_BYPASS=false
DEV_LOCAL_OPEN_ID=
MIRA_LOCAL_FILE_STORE=false
DEV_LOCAL_VISUAL_PLACEHOLDERS=false
MIRA_PAYMENT_MODE=local
STRIPE_PAYMENT_LINK_URL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
STRIPE_CURRENCY=eur
MIRA_EMAIL_WORKER_SECRET=
MIRA_INVITATION_LINK_SECRET=

# Pilot transactional email
MIRA_EMAIL_PROVIDER=
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
MIRA_INVITATION_FROM=
MIRA_PUBLIC_APP_BASE_URL=

# Manus/Forge model, image, storage, and platform services
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
OPENAI_API_KEY=
OPENAI_EMBEDDING_BASE_URL=https://api.openai.com
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_VOICE=marin
OPENAI_REALTIME_CUSTOM_VOICE_ID=
OPENAI_REALTIME_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
VITE_FRONTEND_FORGE_API_URL=
VITE_FRONTEND_FORGE_API_KEY=

# MIRA feature flags
MIRA_V3_ENABLED=false
MIRA_V3_BIRTH_DATA_ENABLED=false
MIRA_PILOT_QA_RETENTION_DAYS=7

# Optional providers
DAKIDARTS_API_KEY=
DAKIDARTS_API_BASE_URL=https://api.numerologyapi.com/api/v1
NOTION_INTELLIGENCE_ENABLED=false
NOTION_API_KEY=
NOTION_DATABASE_ID=
NOTION_API_BASE_URL=https://api.notion.com

# Runtime and local branding
PORT=3000
VITE_APP_TITLE=Mira
VITE_APP_LOGO=
# Standalone brand coach (requires server-provisioned brand_coaching workspace grant)
MIRA_COACH_ENABLED=false
# Reviewed discovery and adaptive interview state; requires migration 0024.
MIRA_COACH_INTERVIEW_ENABLED=false
# Durable timed conversations: requires interview flag + migration 0025; audio remains separate.
MIRA_COACH_CALL_ENABLED=false
# Chained voice uses the same timed adaptive workflow; disabled until configured/authorised.
MIRA_COACH_AUDIO_ENABLED=false
MIRA_COACH_REFERENCE_VISION_ENABLED=false
MIRA_COACH_TRANSCRIPTION_MODEL=gpt-transcribe
MIRA_COACH_SPEECH_MODEL=gpt-4o-mini-tts
MIRA_COACH_SPEECH_VOICE=marin
# Development-only private client reference storage; production needs a durable adapter.
MIRA_COACH_REFERENCE_ROOT=
MIRA_COACH_PROVIDER=forge
MIRA_COACH_MODEL=gpt-5-mini
# Completion budget includes reasoning where applicable; integer 1–1800.
MIRA_COACH_MAX_COMPLETION_TOKENS=1800
# Metadata-only coach telemetry; global LangGraph content tracing remains suppressed.
MIRA_COACH_TELEMETRY_ENABLED=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=mira-development
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_WORKSPACE_ID=
LANGSMITH_TRACING=false

# Shared editorial library: admin-only import/review/publish; off by default.
MIRA_KNOWLEDGE_ENABLED=false

# Development-only private PDF storage and Python extractor (blank uses repo-local defaults).
MIRA_KNOWLEDGE_DOCUMENT_ROOT=
MIRA_PDF_PYTHON=

# Coach retrieval uses only published editorial knowledge; separate from private client evidence.
MIRA_COACH_KNOWLEDGE_ENABLED=false
MIRA_COACH_KNOWLEDGE_LANGUAGE=en

# Pinecone is the selected destination for shared book-knowledge search.
# Adapter/preview implemented; these values alone do not activate reads or uploads.
# Keep the API key server-side. Use the index's data-plane host from Pinecone.
PINECONE_API_KEY=
PINECONE_INDEX_HOST=
PINECONE_NAMESPACE=mira-expertise
# Explicit read activation is separate from credentials. Keep off until seeded/reviewed.
MIRA_COACH_KNOWLEDGE_BACKEND=lexical
MIRA_PINECONE_READ_ENABLED=false
